---
import Base from '../../layouts/Base.astro';
import SupportEmail from '../../components/SupportEmail.astro';
import { MARKATT, isPlaceholder, formatDate } from '../../consts';

const title = 'markAtt privacy policy';
const description =
  'What the markAtt app stores, where it is stored, and who can see it.';
const updated = MARKATT.lastUpdated;
const region = MARKATT.supabaseRegion;
const regionPending = isPlaceholder(region);
---

<!--
  REVIEW REQUIRED before app store submission.
  This policy must match the App Store privacy labels and the Google Play
  Data Safety form exactly. A mismatch is a common rejection reason.
  Children's data is involved — have this reviewed by someone qualified
  under the Australian Privacy Act, and confirm the consent arrangement
  with the school.
-->
<Base title={title} description={description}>
  <div class="prose">
    <h1>markAtt privacy policy</h1>

    <p class="meta">
      Last updated <time datetime={updated}>{formatDate(updated)}</time>
    </p>

    <h2>Who this covers</h2>

    <p>
      markAtt is used by teachers at a community Sunday school. Students and
      parents do not use the app. This policy explains what the app stores,
      where it is kept, and who is able to see it.
    </p>

    <h2>What the app stores</h2>

    <p>
      <strong>Your teacher account.</strong> Your email address, your name, and your
      role. Passwords are handled by Supabase Auth and are stored hashed. The app
      never sees a plain password.
    </p>

    <p>
      <strong>Student records.</strong> A student's name, their class, and their term
      enrolment. These are entered by the school.
    </p>

    <p>
      <strong>Attendance and homework records.</strong> One mark per student per
      session, together with the date of that session.
    </p>

    <h2>What the app does not do</h2>

    <ul>
      <li>No advertising.</li>
      <li>No analytics and no tracking.</li>
      <li>No location data.</li>
      <li>No payments.</li>
      <li>No selling or sharing of data with third parties.</li>
      <li>No data is used to train any model.</li>
    </ul>

    <h2>Where data is stored</h2>

    <p>
      Data is stored in Supabase, a hosted Postgres service, in the {
        regionPending ? <span class="placeholder">{region}</span> : region
      } region.
    </p>

    <h2>Who can see it</h2>

    <p>
      Access is restricted at the database level using row-level security. A
      teacher can only read and write records for their own class. School
      administrators can see their own school's records.
    </p>

    <h2>Children's information</h2>

    <p>
      Student records relate to children. The school decides which students are
      enrolled, and the school is responsible for obtaining consent from parents.
    </p>

    <p>
      The information held about a student is limited to their name, their class,
      and their attendance and homework marks. No photographs, no contact
      details, and no free-text notes about students are collected.
    </p>

    <h2>How long it is kept</h2>

    <p>
      Records are kept for as long as the school uses the app. The school can
      request deletion of its data at any time.
    </p>

    <h2>Questions and requests</h2>

    <p>
      If you have a question about this policy, or you want data corrected or
      deleted, email <SupportEmail />. This is the same address as
      the <a href="/markatt/support/">markAtt support page</a>.
    </p>

    <h2>Changes to this policy</h2>

    <p>
      If this policy changes, the updated version will be posted on this page
      with a new last-updated date.
    </p>
  </div>
</Base>
