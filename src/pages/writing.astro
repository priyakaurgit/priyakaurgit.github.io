---
import Base from '../layouts/Base.astro';

const title = 'Writing';
const description =
  'Writing from Priya Kaur: activity books for children on Amazon now, and, after the markAtt pilot, building software as a solo developer, QA practice, and working with AI tools.';
---

<Base title={title} description={description}>
  <h1>Writing</h1>

  <p class="lead">
    I already write for children — the <a href="/work/"
      >Happy Little Coloring Adventures</a
    > series is on Amazon. Writing here starts after the markAtt pilot, and will
    cover building software as a solo developer, QA practice, and working with AI
    tools.
  </p>
</Base>
